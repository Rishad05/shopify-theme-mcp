{%- doc -%}
  Loads the custom design layer, plus the demo placeholder image map.

  Must be rendered after 'theme-styles-variables' and 'color-palette', which
  emit their tokens from inline {% style %} blocks. Those blocks sit later in
  the document than a <link> from 'stylesheets', so a token redefined in
  custom.css only wins if custom.css is linked after them.

  The placeholder URLs are passed to CSS as custom properties rather than being
  written into custom.css directly: a plain .css asset can't call asset_url, and
  hardcoding a relative path would assume custom.css and the images are always
  served from the same CDN directory.

  @example
  {%- render 'custom-styles' -%}
{%- enddoc -%}

{% style %}
  :root {
    /* Demo placeholder photography (Unsplash licence — free to use, attribution
       not required). These are only ever painted onto Shopify's placeholder
       SVGs, which disappear on their own the moment a product, collection or
       section has real media — so nothing here reaches a storefront that has its
       own images.

       To swap one, drop a replacement over the file in assets/ and keep the
       name. Sources (unsplash.com/photos/<id>):

         product-1     1528825871115-3581a5387919   detail-1     1610348725531-843dff563e2c
         product-2     1517093157656-b9eccef91cb1   detail-2     1512621776951-a57141f2eefd
         product-3     1519996529931-28324d5a630e   hero-1       1498837167922-ddd27525d352
         collection-1  1509440159596-0249088772ff   hero-2       1543168256-418811576931
         collection-2  1471193945509-9ad0617afabf   hero-3       1488459716781-31db52582fe9
         collection-3  1542838132-92c53300491e     blog-1       1555939594-58d7cb561ad1 */
    --placeholder-product-1: url({{ 'placeholder-product-1.jpg' | asset_url }});
    --placeholder-product-2: url({{ 'placeholder-product-2.jpg' | asset_url }});
    --placeholder-product-3: url({{ 'placeholder-product-3.jpg' | asset_url }});
    --placeholder-collection-1: url({{ 'placeholder-collection-1.jpg' | asset_url }});
    --placeholder-collection-2: url({{ 'placeholder-collection-2.jpg' | asset_url }});
    --placeholder-collection-3: url({{ 'placeholder-collection-3.jpg' | asset_url }});
    --placeholder-hero-1: url({{ 'placeholder-hero-1.jpg' | asset_url }});
    --placeholder-hero-2: url({{ 'placeholder-hero-2.jpg' | asset_url }});
    --placeholder-hero-3: url({{ 'placeholder-hero-3.jpg' | asset_url }});
    --placeholder-detail-1: url({{ 'placeholder-detail-1.jpg' | asset_url }});
    --placeholder-detail-2: url({{ 'placeholder-detail-2.jpg' | asset_url }});
    --placeholder-blog-1: url({{ 'placeholder-blog-1.jpg' | asset_url }});
  }
{% endstyle %}

{{ 'custom.css' | asset_url | stylesheet_tag }}
